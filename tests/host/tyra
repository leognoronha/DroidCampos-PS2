struct StaticMesh {
  MeshFrame* frame=new MeshFrame;
  std::vector<MeshMaterial*> materials;std::vector<std::shared_ptr<MeshMaterialFrame>> frames;M4x4 translation,rotation,scale;
  M4x4 getModelMatrix()const{return translation*rotation*scale;}
  explicit StaticMesh(const MeshBuilderData* b):frames(b->frames){for(auto& m:b->materials)materials.push_back(new MeshMaterial(m));}
  ~StaticMesh(){for(auto* m:materials)delete m;delete frame;}
};
struct ObjLoaderOptions {float scale=1;bool flipUVs=false;};
struct FileUtils {inline static std::string root;static std::string fromCwd(const std::string& s){return root+s;}};
struct ObjLoader {
  static std::unique_ptr<MeshBuilderData> load(const std::string& path,const ObjLoaderOptions&){
    static u32 next=1; auto b=std::make_unique<MeshBuilderData>();
    std::ifstream file(path.substr(0,path.size()-4)+".mtl");std::string line;
    while(std::getline(file,line)){
      std::istringstream in(line);std::string token,value;in>>token>>value;
      if(token=="newmtl"){MeshMaterial m{};m.id=next++;m.name=value;b->materials.push_back(m);}
      if(token=="Kd"){float g=0,bv=0;in>>g>>bv;b->materials.back().ambient.set(std::stof(value)*128,g*128,bv*128,128);}
      if(token=="map_Kd") b->materials.back().textureName=value.substr(0,value.size()-4);
    }
    assert(!b->materials.empty());
    std::ifstream obj(path);std::vector<Vec4> vertices;std::vector<std::vector<Vec4>> faces(b->materials.size());
    unsigned material=0;
    while(std::getline(obj,line)){
      std::istringstream in(line);std::string token;in>>token;
      if(token=="v"){float x,y,z;in>>x>>y>>z;vertices.emplace_back(x,y,z,1);}
      else if(token=="usemtl"){std::string name;in>>name;for(unsigned i=0;i<b->materials.size();i++)if(b->materials[i].name==name)material=i;}
      else if(token=="f"){
        std::string value;std::vector<int> indices;while(in>>value){int index=std::stoi(value.substr(0,value.find('/')));indices.push_back(index>0?index-1:int(vertices.size())+index);}
        for(unsigned i=1;i+1<indices.size();i++)for(unsigned j:{0U,i,i+1})faces[material].push_back(vertices.at(indices[j]));
      }
    }
    for(unsigned i=0;i<b->materials.size();i++){
      auto f=std::make_shared<MeshMaterialFrame>();f->ownedVertices=std::move(faces[i]);
      f->count=f->ownedVertices.size();f->vertices=f->ownedVertices.data();
      b->materials[i].frames.push_back(f.get());b->frames.push_back(std::move(f));
    }
    return b;
  }
};
