struct TextureData {int width=0,height=0,bpp=32;unsigned char* data=nullptr;};
struct Texture {std::string path;u32 id;TextureData* core=nullptr;std::vector<u32> links;void addLink(u32 x){links.push_back(x);}};
struct TextureRepository {
  std::map<u32,std::unique_ptr<Texture>> textures;u32 next=1;
  Texture* add(const std::string& path){auto t=std::make_unique<Texture>();t->path=path;t->id=next++;auto* p=t.get();textures[p->id]=std::move(t);return p;}
  void addByMesh(StaticMesh* m,const std::string& root,const char*){for(auto* mat:m->materials)if(mat->textureName)add(root+*mat->textureName)->addLink(mat->id);}
  Texture* getByTextureId(u32 id){return textures.at(id).get();}
  Texture* getByMeshMaterialId(u32 id){for(auto& t:textures)for(auto link:t.second->links)if(link==id)return t.second.get();return nullptr;}
  void free(u32 id){assert(textures.erase(id)==1);}
  void freeByMesh(StaticMesh* m){for(auto* mat:m->materials)for(auto it=textures.begin();it!=textures.end();){
    bool found=false;for(auto link:it->second->links)if(link==mat->id)found=true;
    if(found)it=textures.erase(it);else ++it;
  }}
  void freeBySprite(const Sprite& s){auto* t=getByMeshMaterialId(s.id);assert(t);free(t->id);}
  u32 getTexturesCount()const{return textures.size();}
};
