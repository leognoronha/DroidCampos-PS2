struct StaticPipeline {
  struct {void clearGeometryCache(){}u32 getMaxVertCountByParams(bool,bool,bool){return 54;}}core;
  inline static std::vector<Vec4> draws;
  inline static std::vector<float> geometrySignatures;
  inline static bool visible=true;
  void setRenderer(RendererCore*){}
  bool isVisible(const StaticMesh*) const {return visible;}
  void render(StaticMesh* m,const StaPipOptions&){draws.push_back(m->translation.position);RendererCore::renderEvents.push_back("draw");float sum=0;for(auto* mat:m->materials)for(u32 i=0;i<mat->frames[0]->count;i+=17){auto& v=mat->frames[0]->vertices[i];sum+=v.x+v.y*2+v.z*3;}geometrySignatures.push_back(sum);}
};
