  float x=0,y=0,z=0,w=0;
  Vec4()=default;
  Vec4(float a,float b,float c,float d=1):x(a),y(b),z(c),w(d){}
  void set(float a,float b,float c,float d=1){x=a;y=b;z=c;w=d;}
};
struct Buttons {
  bool Cross=false,Square=false,Circle=false,Triangle=false,Select=false,Start=false;
  bool L1=false,R1=false,L2=false,R2=false,L3=false,R3=false;
  bool DpadUp=false,DpadDown=false,DpadLeft=false,DpadRight=false;
