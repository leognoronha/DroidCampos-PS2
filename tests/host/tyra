struct M4x4 {
  Vec4 position;float data[16];
  M4x4(){identity();}
  void identity(){position={};std::fill(data,data+16,0.F);data[0]=data[5]=data[10]=data[15]=1;}
  M4x4 operator*(const M4x4& b)const{M4x4 r;for(int c=0;c<4;c++)for(int i=0;i<4;i++){
    r.data[c*4+i]=0;for(int k=0;k<4;k++)r.data[c*4+i]+=data[k*4+i]*b.data[c*4+k];}return r;}
  Vec4 operator*(const Vec4& v)const{return Vec4(data[0]*v.x+data[4]*v.y+data[8]*v.z+data[12]*v.w,
    data[1]*v.x+data[5]*v.y+data[9]*v.z+data[13]*v.w,data[2]*v.x+data[6]*v.y+data[10]*v.z+data[14]*v.w,
    data[3]*v.x+data[7]*v.y+data[11]*v.z+data[15]*v.w);}
  void translate(Vec4 p){M4x4 t;t.data[12]=p.x;t.data[13]=p.y;t.data[14]=p.z;*this=*this*t;position=p;}
  void scale(Vec4 v){M4x4 t;t.data[0]=v.x;t.data[5]=v.y;t.data[10]=v.z;*this=*this*t;}
  void rotateX(float v){M4x4 t;t.data[5]=t.data[10]=std::cos(v);t.data[6]=std::sin(v);t.data[9]=-std::sin(v);*this=*this*t;}
  void rotateY(float v){M4x4 t;t.data[0]=t.data[10]=std::cos(v);t.data[8]=std::sin(v);t.data[2]=-std::sin(v);*this=*this*t;}
  void rotateZ(float v){M4x4 t;t.data[0]=t.data[5]=std::cos(v);t.data[1]=std::sin(v);t.data[4]=-std::sin(v);*this=*this*t;}
};
